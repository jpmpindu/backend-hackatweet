# Copier ce fichier en .env puis remplir les valeurs réelles :
#   cp .env.example .env
# Ne jamais committer le fichier .env

# --- Serveur ---
PORT=3000

# --- MongoDB Atlas ---
# Atlas > Database > Connect > Drivers : copier la chaîne de connexion
# Remplacer <username>, <password>, <cluster> et le nom de la base (hackatweet)
# Si le mot de passe contient des caractères spéciaux (@, :, /, ?...), les encoder en URL
CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hackatweet?retryWrites=true&w=majority

# --- Clé API ---
# Clé secrète envoyée par les clients dans l'en-tête "x-api-key"
# Générer une valeur aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change_me

# --- CORS ---
# URL du frontend autorisée à appeler l'API
FRONTEND_URL=http://localhost:3001
